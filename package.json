{
  "name": "farmpulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:start": "docker start farmpulse-postgres || docker run --name farmpulse-postgres -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=farmpulse -p 5433:5432 -v farmpulse-postgres-data:/var/lib/postgresql/data -d postgres:16-alpine",
    "db:stop": "docker stop farmpulse-postgres",
    "db:seed": "npm run db:seed:development",
    "db:seed:development": "tsx prisma/seed.ts",
    "db:initialize:production": "tsx scripts/initialize-production.ts",
    "db:cleanup:mock": "tsx scripts/cleanup-mock-data.ts",
    "db:verify:production": "tsx scripts/verify-production.ts",
    "db:import:land-design": "tsx scripts/import-land-design.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@aws-sdk/client-s3": "^3.1101.0",
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.468.0",
    "next": "^16.2.12",
    "next-auth": "^5.0.0-beta.29",
    "prisma": "^6.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.2.12",
    "postcss": "8.5.25",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "sharp": "0.35.3",
    "postcss": "8.5.25"
  }
}
